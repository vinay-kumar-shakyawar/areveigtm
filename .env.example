# ---------------------------------------------------------------------------
# AREVEI GTM environment configuration
# Copy to .env and fill what you use. Nothing here is required except the
# first block; every provider is optional and can also be configured per
# workspace from Settings → Integrations (stored encrypted in the database).
# ---------------------------------------------------------------------------

# --- Core (required) --------------------------------------------------------
# Postgres connection string. For local dev without Docker, `npm run dev:db`
# starts an embedded Postgres on this URL.
DATABASE_URL=postgresql://arevei:arevei@localhost:54329/arevei_gtm
# Public URL of the app (used in emails, unsubscribe links, OAuth callbacks).
APP_BASE_URL=http://localhost:3000
# 32 random bytes, base64. Encrypts workspace credentials (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Secret for signing one-time codes / tokens (any long random string).
JWT_SECRET=
NODE_ENV=development
LOG_LEVEL=info

# --- Optional infrastructure ------------------------------------------------
# Redis is optional. The job queue runs on Postgres (pg-boss) by default.
REDIS_URL=
# Set to true to seed demo data on `npm run db:seed` (never in production).
SEED_DEMO=false
# Allow system-level provider keys below to be used by any workspace that has
# not configured its own provider. Default false = each workspace brings keys.
ALLOW_SYSTEM_PROVIDER_FALLBACK=false

# --- Transactional email (sign-in codes, invitations) -----------------------
# One of: smtp | resend | sendgrid | ses | console (prints to log)
SYSTEM_EMAIL_PROVIDER=console
SYSTEM_EMAIL_FROM="AREVEI GTM <no-reply@example.com>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# --- LLM providers (system-level defaults; optional) ------------------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# --- Lead data providers (optional) -----------------------------------------
APOLLO_API_KEY=
PEOPLE_DATA_LABS_API_KEY=
HUNTER_API_KEY=
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
EXA_API_KEY=
FIRECRAWL_API_KEY=

# --- Outbound email providers (optional) -------------------------------------
# Workspaces normally add these under Integrations; env values are system-level
# fallbacks used only when ALLOW_SYSTEM_PROVIDER_FALLBACK=true.
RESEND_API_KEY=
SENDGRID_API_KEY=
# Delivery-event webhooks: point the provider at
#   {APP_BASE_URL}/api/webhooks/resend/{integrationId}
#   {APP_BASE_URL}/api/webhooks/sendgrid/{integrationId}
#   {APP_BASE_URL}/api/webhooks/ses/{integrationId}   (SNS HTTPS subscription)
# Signing material is stored per integration; these env values are fallbacks.
RESEND_WEBHOOK_SECRET=
SENDGRID_WEBHOOK_PUBLIC_KEY=

# --- Mailbox OAuth apps (optional; needed to connect Gmail / Microsoft 365) --
# Redirect URIs to register: {APP_BASE_URL}/api/oauth/google/callback and
# {APP_BASE_URL}/api/oauth/microsoft/callback. Scopes: gmail.send + gmail.readonly,
# Mail.Send + Mail.Read + offline_access.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common

# --- LinkedIn through an authorized provider (optional) ---------------------
# Unipile hosted auth links members' own LinkedIn accounts; AREVEI never handles
# LinkedIn passwords or cookies. Reply webhooks register themselves from the UI.
UNIPILE_DSN=
UNIPILE_API_KEY=

# --- X (Twitter) API v2 OAuth 2.0 app (optional) ----------------------------
# Redirect URI: {APP_BASE_URL}/api/oauth/x/callback. Needs a project with DM access.
X_CLIENT_ID=
X_CLIENT_SECRET=
